# NVIDIA NGC API key (https://build.nvidia.com/)
NGC_API_KEY=

# HuggingFace token for FLUX model (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Optional Exa API key for product web insights (https://dashboard.exa.ai/)
EXA_API_KEY=

# --- Hosted NVIDIA endpoints (instead of self-hosted NIM containers) --------
# config.yaml defaults to the NIM container hostnames, which need datacentre
# GPUs (1x A100 minimum per model). To use build.nvidia.com's hosted models
# instead, set NVIDIA_API_BASE_URL -- it redirects the VLM, LLM and embeddings
# sections at once.
#
# Model names only need overriding where the hosted catalog id differs from the
# container image. nv-embedqa-e5-v5 is not published hosted, so embeddings must
# be pointed at a catalog model; the VLM and LLM names are identical either way.
#   NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
#   EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b
# Not every catalog-listed embedding model is enabled per account: of the
# seven listed, only nemotron-3-embed-1b and llama-nemotron-embed-vl-1b-v2
# returned 200 on a fresh free-tier key; the rest gave 404 Not Found.
# Note these are 2048-dim vs nv-embedqa-e5-v5's 1024, and
# PolicyLibrary._ensure_collection does not recreate an existing Milvus
# collection on a dimension change -- drop it first when switching.
#   VLM_MODEL=            # optional, defaults to config.yaml
#   LLM_MODEL=            # optional, defaults to config.yaml

# Arize Phoenix tracing (optional). Start the collector with:
#   docker compose up -d phoenix    then open http://localhost:6006
TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=catalog-enrichment

# The phoenix compose service enables auth by default and needs a secret to
# start. Generate one with: openssl rand -hex 32
# Then log in at http://localhost:6006, create a system key under
# Settings -> API Keys, and set PHOENIX_API_KEY below so the exporter can
# authenticate. Set PHOENIX_ENABLE_AUTH=false only for a collector that is
# reachable from nothing but localhost.
PHOENIX_SECRET=
PHOENIX_API_KEY=

# Phoenix base URL, used by the phoenix MCP server in .mcp.json (NOT by the
# exporter). This is the site root -- no /v1/traces suffix. Getting the two
# confused is the easy mistake: PHOENIX_COLLECTOR_ENDPOINT above ends in
# /v1/traces because it names the OTLP ingest path; this one does not.
PHOENIX_BASE_URL=http://localhost:6006

# Anything that exposes the collector beyond localhost -- a Cloudflare/ngrok
# tunnel, a LAN address, a cloud host -- must keep auth on: traces carry full
# prompts and model completions.

# To use hosted Phoenix Cloud instead of a local collector, point the endpoint
# at your space's hostname (Phoenix Cloud is hostname-scoped, e.g.
# https://<your-space>.arize.com) and set PHOENIX_API_KEY from that space.
# The SDK reads PHOENIX_API_KEY automatically.
#   PHOENIX_COLLECTOR_ENDPOINT=https://<your-space>.arize.com/v1/traces
