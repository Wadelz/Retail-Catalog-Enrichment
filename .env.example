# NVIDIA NGC API key (https://build.nvidia.com/)
NGC_API_KEY=

# HuggingFace token for FLUX model (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Optional Exa API key for product web insights (https://dashboard.exa.ai/)
EXA_API_KEY=

# Arize Phoenix tracing (optional). Start the collector with:
#   docker compose up -d phoenix    then open http://localhost:6006
TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=catalog-enrichment
