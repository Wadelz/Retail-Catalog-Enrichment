{
  "mcpServers": {
    "phoenix": {
      "command": "npx",
      "args": [
        "-y",
        "@arizeai/phoenix-mcp@4.3.6",
        "--baseUrl",
        "${PHOENIX_BASE_URL:-http://localhost:6006}",
        "--apiKey",
        "${PHOENIX_API_KEY}",
        "--project",
        "${PHOENIX_PROJECT_NAME:-catalog-enrichment}"
      ]
    }
  }
}
